    {
      "id": "ssa_trust_fund",
      "label": "Social Security trust fund reserve depletion (OASI)",
      "maintenance_due_on": "2027-06-30",
      "provenance": {
        "conversion": "Depletion quarters are carried as the calendar YEAR in which reserves run out (2032 Q4 -> 2032), so a reduction begins in the year of depletion rather than the year after. The payable path is the intermediate alternative's two published endpoints -- 78 percent at depletion, 62 percent in 2100 -- and the straight line between them is THIS APP'S interpolation, not the report's; it is disclosed as such. The low-cost and high-cost alternatives contribute their depletion YEARS only: their payable percentages are not stated in the sources below and are recorded as null rather than guessed. DI reserves are projected positive throughout the 75-year period, so no DI depletion is modelled. The theoretical combined OASDI figures are carried for disclosure only and never reduce a benefit, because the law does not permit interfund borrowing and the app does not predict that it will.",
        "sources": [
          "https://www.ssa.gov/oact/TR/2026/",
          "https://www.ssa.gov/oact/TR/2026/II_A_highlights.html",
          "https://www.ssa.gov/oact/TR/2026/IV_B_LRest.html",
          "https://www.ssa.gov/news/en/press/releases/2026-06-09.html"
        ],
        "verified_as_of": "2026-08-17"
      },
      "provenance_status": "official_ssa_trustees_report_2026",
      "scope": "OASI reserve depletion timing and the share of scheduled benefits payable afterwards, under the Trustees' three published alternatives. Legislation is not projected.",
      "source_vintage": "2026 OASDI Trustees Report (intermediate assumptions set February 2026)",
      "values": {
        "assumptions_set": "2026-02",
        "combined_oasdi_theoretical_depletion_year": 2034,
